{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["chrome", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "entrypoints/**/*",
    "components/**/*",
    "hooks/**/*",
    "utils/**/*",
    "tests/**/*",
    "__mocks__/**/*",
    "wxt.config.ts",
    ".wxt/wxt.d.ts"
  ]
}
